				"flex-basis:100%;"
				"height:45px;"
			"}"
			".menu > .left, .right {"
				"display:flex;"
				"flex-basis:100%;"
				"height:100%;"
				"align-content:center;"
				"align-items:center;"
			"}"
			".menu > .left,.right > * {"
				"margin:5px;"
