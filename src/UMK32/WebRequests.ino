		"<style>"
			":root {"
				/*New colors*/
				"--dark-bg:#515151;"
				"--darker-bg:#414141;"
				"--light-text:#fff;"
				"--lighter-text:#ddd;"
				"--dark-text:#353535;"
				"--darker-text:#222;"
